{
  "name": "kosovo-import-cost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that estimates Paketos shipping, Kosovo customs duty and VAT for Amazon products.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "tariff": "node scripts/build-tariff.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check": "prettier --check ."
  },
  "dependencies": {
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^20",
    "esbuild": "^0.28.1",
    "jsdom": "^30",
    "prettier": "^3.9.6",
    "typescript": "^6",
    "vitest": "^4"
  }
}
